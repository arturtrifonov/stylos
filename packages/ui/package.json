{
  "name": "@stylos/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Stylos Design System — Svelte 5 component package. Built to docs/specs/0009-stylos-ui-package.md.",
  "type": "module",
  "scripts": {
    "prebuild": "cd ../.. && npm run ui:generate",
    "build": "svelte-package -i src -o dist/package",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "svelte": "./src/index.ts",
  "exports": {
    ".": {
      "svelte": "./src/index.ts"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./css": "./dist/css/stylos.css",
    "./css/*.css": "./dist/css/*.css",
    "./registry.json": "./dist/registry.json",
    "./registry/*.json": "./dist/registry/*.json",
    "./stylelint": "./stylelint.config.js",
    "./skill": "./skill/SKILL.md",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "svelte": "^5.46.4",
    "svelte-check": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^8.0.0"
  },
  "license": "UNLICENSED"
}
